generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  TOURNAMENT_ADMIN
  SCORER
  VIEWER
}

enum MatchStatus {
  SCHEDULED
  READY
  LIVE
  INNINGS_BREAK
  COMPLETED
  ARCHIVED
  ABANDONED
  DELAYED
}

enum TossDecision {
  BAT
  BOWL
}

enum BallType {
  NORMAL
  WIDE
  NO_BALL
  BYE
  LEG_BYE
}

enum WicketType {
  BOWLED
  CAUGHT
  LBW
  STUMPED
  RUN_OUT
  HIT_WICKET
  RETIRED_HURT
  TIMED_OUT
  OBSTRUCTING_FIELD
}

enum MatchFormat {
  T20
  ODI
  TEST
  T10
  CUSTOM
}

enum NotificationType {
  SYSTEM
  MATCH_CREATED
  MATCH_STARTED
  MATCH_COMPLETED
  TEAM_CREATED
  PLAYER_CREATED
  BOUNDARY
  SIX
  WICKET
  RESULT
  INNINGS_BREAK
  MILESTONE
}

enum BallResult {
  DOT
  ONE
  TWO
  THREE
  FOUR
  SIX
  WIDE
  NO_BALL
  BYE
  LEG_BYE
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  image         String?
  phone         String?
  bio           String?
  role          UserRole  @default(VIEWER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  passwordResets PasswordResetToken[]
  teams         Team[]           @relation("TeamOwner")
  players       Player[]         @relation("PlayerUser")
  createdMatches Match[]         @relation("MatchCreator")
  scorerAssignments MatchScorer[]
  tournaments   Tournament[]     @relation("TournamentOwner")
  notifications Notification[]
  comments      Commentary[]

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expires   DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([token])
}

model Team {
  id            String   @id @default(cuid())
  name          String
  shortName     String
  logo          String?
  primaryColor  String   @default("#2563EB")
  secondaryColor String  @default("#00D4FF")
  ownerId       String
  country       String?
  city          String?
  founded       Int?
  description   String?  @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner         User       @relation("TeamOwner", fields: [ownerId], references: [id])
  players       Player[]
  homeMatches   Match[]    @relation("HomeTeam")
  awayMatches   Match[]    @relation("AwayTeam")
  tournaments   TournamentTeam[]
  standings     TournamentStanding[]
  squadMatches  MatchPlayer[]

  @@index([name])
  @@index([shortName])
}

model Player {
  id            String   @id @default(cuid())
  name          String
  shortName     String?
  dateOfBirth   DateTime?
  image         String?
  nationality   String?
  battingStyle  String?
  bowlingStyle  String?
  role          String?
  bio           String?  @db.Text
  isCaptain     Boolean  @default(false)
  isActive      Boolean  @default(true)
  userId        String?
  teamId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User?    @relation("PlayerUser", fields: [userId], references: [id])
  team          Team?    @relation(fields: [teamId], references: [id])
  battingStats  BattingScorecard[]
  bowlingStats  BowlingScorecard[]
  manOfTheMatch ManOfTheMatch[]
  matchSquads   MatchPlayer[]

  @@index([name])
  @@index([teamId])
}

model Ground {
  id          String   @id @default(cuid())
  name        String
  city        String
  country     String
  capacity    Int?
  image       String?
  pitchType   String?
  outfield    String?
  description String?  @db.Text
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  matches     Match[]

  @@index([name])
}

model Tournament {
  id            String   @id @default(cuid())
  name          String
  shortName     String?
  description   String?  @db.Text
  format        MatchFormat @default(T20)
  logo          String?
  banner        String?
  startDate     DateTime
  endDate       DateTime
  maxTeams      Int?
  totalOvers    Int      @default(20)
  isPublic      Boolean  @default(true)
  status        String   @default("upcoming")
  ownerId       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner         User          @relation("TournamentOwner", fields: [ownerId], references: [id])
  matches       Match[]
  teams         TournamentTeam[]
  standings     TournamentStanding[]
  sponsors      Sponsor[]
  gallery       Gallery[]

  @@index([name])
  @@index([startDate])
}

model TournamentTeam {
  id           String      @id @default(cuid())
  tournamentId String
  teamId       String
  groupId      String?
  registeredAt DateTime    @default(now())

  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team         Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, teamId])
}

model TournamentStanding {
  id            String      @id @default(cuid())
  tournamentId  String
  teamId        String
  matchesPlayed Int         @default(0)
  wins          Int         @default(0)
  losses        Int         @default(0)
  ties          Int         @default(0)
  noResult      Int         @default(0)
  points        Int         @default(0)
  nrr           Float       @default(0)
  position      Int?
  updatedAt     DateTime    @updatedAt

  tournament    Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, teamId])
}

model Match {
  id            String       @id @default(cuid())
  name          String
  description   String?      @db.Text
  format        MatchFormat  @default(T20)
  totalOvers    Int          @default(20)
  status        MatchStatus  @default(SCHEDULED)
  scheduledAt   DateTime
  startedAt     DateTime?
  completedAt   DateTime?
  venue         String?
  groundId      String?
  weather       String?
  pitchCondition String?
  tossWinner    String?
  tossDecision  TossDecision?
  result        String?
  winningTeamId String?
  matchReferee  String?
  umpire1       String?
  umpire2       String?
  thirdUmpire   String?
  reserveUmpire String?
  createdBy     String
  isPaused      Boolean     @default(false)
  tournamentId  String?
  homeTeamId    String
  awayTeamId    String
  isPublic      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  creator       User            @relation("MatchCreator", fields: [createdBy], references: [id])
  tournament    Tournament?     @relation(fields: [tournamentId], references: [id])
  ground        Ground?         @relation(fields: [groundId], references: [id])
  homeTeam      Team            @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam      Team            @relation("AwayTeam", fields: [awayTeamId], references: [id])
  matchScorers  MatchScorer[]
  squads        MatchPlayer[]
  innings       Innings[]
  events        MatchEvent[]
  commentary    Commentary[]
  playerOfMatch PlayerOfMatch?
  manOfTheMatch ManOfTheMatch?

  @@index([status])
  @@index([scheduledAt])
  @@index([tournamentId])
}

model MatchScorer {
  id        String   @id @default(cuid())
  matchId   String
  userId    String
  createdAt DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([matchId])
  @@index([userId])
}

model MatchPlayer {
  id           String   @id @default(cuid())
  matchId      String
  playerId     String
  teamId       String
  isCaptain    Boolean  @default(false)
  battingOrder Int?
  createdAt    DateTime @default(now())

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id])

  @@unique([matchId, playerId])
  @@index([matchId])
  @@index([teamId])
}

model PlayerOfMatch {
  id        String @id @default(cuid())
  matchId   String @unique
  playerId  String
  match     Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
}

model ManOfTheMatch {
  id        String @id @default(cuid())
  matchId   String @unique
  playerId  String
  match     Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player    Player @relation(fields: [playerId], references: [id])

  @@index([matchId])
}

model Innings {
  id                String   @id @default(cuid())
  matchId           String
  inningsNumber     Int
  battingTeam       String
  bowlingTeam       String
  totalRuns         Int      @default(0)
  totalWickets      Int      @default(0)
  totalOvers        Float    @default(0)
  extras            Int      @default(0)
  declared          Boolean  @default(false)
  targetScore       Int?
  strikerId         String?
  nonStrikerId      String?
  currentBowlerId   String?
  battingOrderCount Int      @default(0)
  endedAt           DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  overs         Over[]
  battingCard   BattingScorecard[]
  bowlingCard   BowlingScorecard[]
  fallOfWickets FallOfWicket[]
  balls         Ball[]

  @@unique([matchId, inningsNumber])
}

model Over {
  id          String   @id @default(cuid())
  inningsId   String
  overNumber  Int
  bowlerId    String
  totalRuns   Int      @default(0)
  totalWickets Int     @default(0)
  ballsCount  Int      @default(0)
  extras      Int      @default(0)
  isCompleted Boolean  @default(false)
  isMaiden    Boolean  @default(false)
  createdAt   DateTime @default(now())

  innings     Innings  @relation(fields: [inningsId], references: [id], onDelete: Cascade)
  balls       Ball[]

  @@unique([inningsId, overNumber])
}

model Ball {
  id           String    @id @default(cuid())
  inningsId    String
  overId       String
  ballNumber   Int
  bowlerId     String
  batsmanId    String
  nonStrikerId String
  runs         Int       @default(0)
  isExtra      Boolean   @default(false)
  extraType    BallType?
  extraRuns    Int       @default(0)
  isWicket     Boolean   @default(false)
  wicketType   WicketType?
  dismissedPlayerId String?
  fielderId    String?
  description  String?
  ballResult   BallResult
  recordedById String?
  updatedById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt

  innings      Innings   @relation(fields: [inningsId], references: [id], onDelete: Cascade)
  over         Over      @relation(fields: [overId], references: [id], onDelete: Cascade)

  @@index([inningsId])
  @@index([overId])
  @@index([bowlerId])
  @@index([batsmanId])
}

model BattingScorecard {
  id           String   @id @default(cuid())
  inningsId    String
  playerId     String
  batPosition  Int
  runs         Int      @default(0)
  balls        Int      @default(0)
  fours        Int      @default(0)
  sixes        Int      @default(0)
  isNotOut     Boolean  @default(false)
  dismissalType String?
  bowlerId     String?
  fielderId    String?
  description  String?
  strikeRate   Float    @default(0)
  battingOrder Int      @default(0)

  innings      Innings  @relation(fields: [inningsId], references: [id], onDelete: Cascade)
  player       Player   @relation(fields: [playerId], references: [id])

  @@unique([inningsId, playerId])
}

model BowlingScorecard {
  id          String   @id @default(cuid())
  inningsId   String
  playerId    String
  overs       Float    @default(0)
  maidens     Int      @default(0)
  runs        Int      @default(0)
  wickets     Int      @default(0)
  wides       Int      @default(0)
  noBalls     Int      @default(0)
  economy     Float    @default(0)
  strikeRate  Float    @default(0)
  dotBalls    Int      @default(0)

  innings     Innings  @relation(fields: [inningsId], references: [id], onDelete: Cascade)
  player      Player   @relation(fields: [playerId], references: [id])

  @@unique([inningsId, playerId])
}

model FallOfWicket {
  id           String   @id @default(cuid())
  inningsId    String
  wicketNumber Int
  playerId     String
  runs         Int
  overs        Float
  bowlerId     String?
  batterName   String
  createdAt    DateTime @default(now())

  innings      Innings  @relation(fields: [inningsId], references: [id], onDelete: Cascade)

  @@unique([inningsId, wicketNumber])
}

model MatchEvent {
  id          String   @id @default(cuid())
  matchId     String
  type        String
  description String   @db.Text
  overNumber  Float?
  ballNumber  Int?
  inningsNumber Int?
  data        Json?
  timestamp   DateTime @default(now())

  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@index([type])
}

model Commentary {
  id            String   @id @default(cuid())
  matchId       String
  userId        String?
  content       String   @db.Text
  overNumber    Float?
  ballNumber    Int?
  inningsNumber Int?
  isAutomatic   Boolean  @default(false)
  isHighlight   Boolean  @default(false)
  eventType     String?
  emoji         String?
  createdAt     DateTime @default(now())

  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id])

  @@index([matchId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  matchId   String?
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model Sponsor {
  id           String   @id @default(cuid())
  name         String
  logo         String
  website      String?
  description  String?
  tier         String   @default("gold")
  tournamentId String
  createdAt    DateTime @default(now())

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

model Gallery {
  id           String   @id @default(cuid())
  url          String
  caption      String?
  type         String   @default("image")
  tournamentId String
  uploadedBy   String?
  createdAt    DateTime @default(now())

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}
